# Base URL of the OpenArm Online API server
OPENARM_ONLINE_API_URL=http://localhost:8000

# API key sent as the X-API-KEY header to the OpenArm Online API (required)
OPENARM_ONLINE_API_KEY=xxx

# Comma-separated IDs of the tasks to claim jobs for (required).
# Tasks are polled in the listed order.
OPENARM_ONLINE_TASK_IDS=1

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL
#LOG_LEVEL=DEBUG

# Interval in seconds between polls for a new job
#POLL_INTERVAL=3

# Timeout in seconds for the evaluate phase (dora run)
#EVALUATE_TIMEOUT=180

# Timeout in seconds for the reset phase (dora run)
#RESET_TIMEOUT=120

# Timeout in seconds for a teleoperation session (dora run)
#TELEOPERATE_TIMEOUT=300

# Directory where the recorder stores recordings
#RECORDER_BASE_DIRECTORY=tmp

# Directory for runner state files such as the not_ready marker
#STATE_DIRECTORY=state

# Dataflow definition file passed to dora run
#DEFAULT_DATAFLOW_FILE=dataflow.yaml

# Dataflow definition file for a specific task. DATAFLOW_FILE_${TASK_ID}
# takes precedence over DEFAULT_DATAFLOW_FILE for the task.
#DATAFLOW_FILE_1=dataflow-task1.yaml

# .env file for a specific task's dataflow. Its values are added to
# the dataflow's environment and win over inherited environment
# variables.
#DATAFLOW_ENV_FILE_1=.env.1.evaluation

# Dataflow definition file passed to dora run for keyboard
# teleoperation. Unset by default: without a dataflow file (this or
# the per-task one below), keyboard teleoperation is disabled for the
# task.
#DEFAULT_KEYBOARD_TELEOPERATION_DATAFLOW_FILE=dataflows/teleoperation/keyboard/mujoco/dataflow.yaml

# Keyboard teleoperation dataflow definition file for a specific task.
# KEYBOARD_TELEOPERATION_DATAFLOW_FILE_${TASK_ID} takes precedence
# over DEFAULT_KEYBOARD_TELEOPERATION_DATAFLOW_FILE for the task.
#KEYBOARD_TELEOPERATION_DATAFLOW_FILE_1=dataflow-keyboard-teleoperation-task1.yaml

# .env file for a specific task's keyboard teleoperation dataflow. Its
# values are added to the dataflow's environment and win over inherited
# environment variables.
#KEYBOARD_TELEOPERATION_DATAFLOW_ENV_FILE_1=.env.1.teleoperation.keyboard

# Dataflow definition file passed to dora run for WebXR teleoperation.
# Unset by default: without a dataflow file (this or the per-task one
# below), WebXR teleoperation is disabled for the task.
#DEFAULT_WEBXR_TELEOPERATION_DATAFLOW_FILE=dataflows/teleoperation/webxr/mujoco/dataflow.yaml

# WebXR teleoperation dataflow definition file for a specific task.
# WEBXR_TELEOPERATION_DATAFLOW_FILE_${TASK_ID} takes precedence over
# DEFAULT_WEBXR_TELEOPERATION_DATAFLOW_FILE for the task.
#WEBXR_TELEOPERATION_DATAFLOW_FILE_1=dataflow-webxr-teleoperation-task1.yaml

# .env file for a specific task's WebXR teleoperation dataflow. Its
# values are added to the dataflow's environment and win over inherited
# environment variables.
#WEBXR_TELEOPERATION_DATAFLOW_ENV_FILE_1=.env.1.teleoperation.webxr

# Frames per second used when converting recordings to .rrd
#RRD_FPS=30

# Time window (HH:MM) in which the runner processes jobs; outside of
# it the runner only sleeps. Both must be set to take effect. A window
# crossing midnight (e.g. start=22:00, end=06:00) is also supported.
#ACTIVE_TIME_START=08:00
#ACTIVE_TIME_END=17:00
